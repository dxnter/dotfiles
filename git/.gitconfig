[core]
  editor = code --wait
  autocrlf = input
  pager = delta --line-numbers --dark
  excludesfile = ~/.gitignore_global
[init]
  defaultBranch = main
[color]
  branch = auto
  diff = auto
  interactive = auto
  pager = true
  status = auto
  ui = true
[delta]
  side-by-side = true
  # bat's Carbonfox theme (bat/.config/bat/themes), matching Ghostty
  syntax-theme = Carbonfox
  minus-style = syntax "#3b1d2b"
  minus-emph-style = syntax "#6b2945"
  plus-style = syntax "#15301f"
  plus-emph-style = syntax "#1d5534"
  line-numbers-minus-style = "#ee5396"
  line-numbers-plus-style = "#25be6a"
  line-numbers-zero-style = "#6e6f70"
  line-numbers-left-style = "#484848"
  line-numbers-right-style = "#484848"
  file-style = bold "#78a9ff"
  file-decoration-style = "#484848" ul
  hunk-header-style = line-number syntax
  hunk-header-decoration-style = "#484848" box
[pager]
  diff = delta
	log = delta
	reflog = delta
	show = delta
[color "status"]
  added = green
  changed = yellow
  untracked = red
[push]
  default = current
  autoSetupRemote = true
[fetch]
  prune = true
[rerere]
  enabled = true
[merge]
  conflictstyle = zdiff3
[diff]
  algorithm = histogram
[rebase]
  autoStash = true
[commit]
	gpgsign = true
[gpg "ssh"]
  # Written by `make ssh`; lets `git log --show-signature` verify your own commits
  allowedSignersFile = ~/.config/git/allowed_signers
[url "git@github.com:"]
    insteadOf = github:
    insteadOf = gh:
[pull]
	ff = only
[user]
  useConfigOnly = true
[include]
  path = ~/.gitconfig.local
[includeIf "gitdir:~/dev/personal/"]
  path = ~/.gitconfig.personal
[includeIf "gitdir:~/dev/oss/"]
  path = ~/.gitconfig.personal
[includeIf "gitdir:~/.dotfiles/"]
  path = ~/.gitconfig.personal
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
